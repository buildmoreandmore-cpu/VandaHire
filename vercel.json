{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "crons": [
    { "path": "/api/cron?job=all", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/api/admin/:action*", "destination": "/api/admin?action=:action*" },
    { "source": "/api/events/submit", "destination": "/api/event-submit" },
    { "source": "/api/stripe/create-checkout", "destination": "/api/stripe?action=checkout" },
    { "source": "/api/stripe/webhook", "destination": "/api/stripe?action=webhook" },
    { "source": "/api/stripe/deposit", "destination": "/api/stripe?action=deposit" },
    { "source": "/api/stripe/balance", "destination": "/api/stripe?action=balance" },
    { "source": "/api/checkin", "destination": "/api/worker?route=checkin" },
    { "source": "/api/incidents", "destination": "/api/worker?route=incidents" },
    { "source": "/api/release", "destination": "/api/worker?route=release" },
    { "source": "/api/exit-reply", "destination": "/api/worker?route=exit-reply" },
    { "source": "/api/verify-video", "destination": "/api/worker?route=verify-video" },
    { "source": "/api/geofence-check", "destination": "/api/worker?route=geofence-check" },
    { "source": "/api/accept-quote", "destination": "/api/worker?route=accept-quote" },
    { "source": "/api/connect-onboard", "destination": "/api/worker?route=connect-onboard" },
    { "source": "/api/connect-dashboard", "destination": "/api/worker?route=connect-dashboard" },
    { "source": "/api/my-earnings", "destination": "/api/worker?route=my-earnings" },
    { "source": "/api/client-survey", "destination": "/api/worker?route=client-survey" },
    { "source": "/api/my-crew-status", "destination": "/api/worker?route=my-crew-status" },
    { "source": "/api/w9", "destination": "/api/worker?route=w9" },
    { "source": "/api/id-upload", "destination": "/api/worker?route=id-upload" },
    { "source": "/api/push", "destination": "/api/worker?route=push-subscribe" },
    { "source": "/api/gps-ping", "destination": "/api/worker?route=gps-ping" },
    { "source": "/api/respond-invite", "destination": "/api/worker?route=respond-invite" },
    { "source": "/api/pin-setup", "destination": "/api/worker?route=pin-setup" },
    { "source": "/api/pin-verify", "destination": "/api/worker?route=pin-verify" },
    { "source": "/api/pin-reset-request", "destination": "/api/worker?route=pin-reset-request" },
    { "source": "/api/pin-reset", "destination": "/api/worker?route=pin-reset" },
    { "source": "/api/session-check", "destination": "/api/worker?route=session-check" },
    { "source": "/api/supervisor-dashboard", "destination": "/api/worker?route=supervisor-dashboard" },
    { "source": "/api/group-info", "destination": "/api/group-info" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|robots\\.txt|sitemap\\.xml|sw\\.js|sw-custom\\.js|manifest\\.webmanifest|registerSW\\.js|workbox-.*).*)", "destination": "/index.html" }
  ]
}
