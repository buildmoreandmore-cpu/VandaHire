{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/admin/:action*", "destination": "/api/admin?action=:action*" },
    { "source": "/api/events/submit", "destination": "/api/event-submit" },
    { "source": "/api/stripe/create-checkout", "destination": "/api/stripe?action=checkout" },
    { "source": "/api/stripe/webhook", "destination": "/api/stripe?action=webhook" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
