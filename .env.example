VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MINIMAX_API_KEY=
PORTER_ADMIN_TOKEN=

# Stripe — Vandahire service-fee collection
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL for Stripe checkout success/cancel redirects
VITE_APP_URL=

# Resend — outbound email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# RingCentral — SMS to workers (primary when configured; takes priority over Twilio)
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
# Optional: production is default; sandbox is https://platform.devtest.ringcentral.com
RINGCENTRAL_SERVER_URL=
# Optional: set to "true" after a High-Volume A2P SMS campaign is approved
RINGCENTRAL_A2P=

# Twilio — SMS to workers (fallback; used only if RingCentral vars are absent)
TWILIO_ACCOUNT_SID=
# Auth: use EITHER a scoped API Key (preferred)…
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# …OR the account Auth Token (fallback)
TWILIO_AUTH_TOKEN=
# Sender: use EITHER a single from-number…
TWILIO_FROM_NUMBER=
# …OR a Messaging Service (recommended; takes priority if set)
TWILIO_MESSAGING_SERVICE_SID=
